# Endpoint que recebe o POST do form de login.
# Rota (PR InMediam/inmediam_api#4908): POST /api/inmediam/phishing/click
# Params em query string: campaign_id, email, action (link_click | form_submit).
# A senha NUNCA é enviada. Sem esta variável, o POST é ignorado e o fluxo segue para /aviso.
#
# Homologação: https://hapi.inmediam.com.br/api/inmediam/phishing/click
# Produção:    https://api.inmediam.com.br/api/inmediam/phishing/click
VITE_CLICK_ENDPOINT=https://hapi.inmediam.com.br/api/inmediam/phishing/click

# Identificador da campanha enviado no body.
VITE_CAMPAIGN_ID=2026-q4-email-ti

# Para onde o botão final da cartilha leva.
VITE_SYSTEM_URL=https://www.inmediam.com.br
