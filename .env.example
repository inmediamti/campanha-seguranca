# Endpoint que recebe o POST ao confirmar o form de login.
# Body enviado: { "campaign_id": "...", "employee_email": "..." } — a senha NUNCA é enviada.
# Sem esta variável, o POST é simplesmente ignorado e o fluxo segue para /aviso.
VITE_CLICK_ENDPOINT=https://sua-api.exemplo.com/phishing/click

# Identificador da campanha enviado no body.
VITE_CAMPAIGN_ID=2024-q4-email-ti

# Para onde o botão final da cartilha leva.
VITE_SYSTEM_URL=https://www.inmediam.com.br

# Canal para o colaborador reportar mensagens suspeitas (opcional).
# Ex.: mailto:ti@inmediam.com.br ou um link de formulário interno.
VITE_REPORT_URL=
